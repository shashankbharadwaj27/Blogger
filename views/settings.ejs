<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <link rel="stylesheet" href="/styles/settings.css">
    <title>Blogger</title>
</head>
<body data-bs-theme="dark">
    <%- include('./partials/nav') %>
    <div class="container rounded mt-0 mb-3" style="min-height: 80vh;">
        <div class="row">
            <div class="col-md-3 border-right">
                <div class="d-flex flex-column align-items-center text-center p-3 py-5">
                    <img class=" mt-5" width="200px" src="<%= currentUser.profileImageUrl %>">
                    <span class="font-weight-bold mt-2 text-white"><%= currentUser.firstName %></span>
                    <span class="text-white"><%= currentUser.email %></span>
                    <span> </span>
                </div>
            </div>
            <div class="col-md-5 border-right">
                <div class="p-3 py-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="text-right">Profile Settings</h4>
                    </div>
                    <form action="/user/settings" method="post" enctype="multipart/form-data" >
                        <div class="row mt-2">
                            <div class="col-md-12">
                                <label class="labels">Profile Photo</label>
                                <input type="file" name="profileImage" id="profilePhoto" class="form-control">
                                 <% if (currentUser.profileImageUrl !== '/images/avatar.png') { %>
                                    <div class="mt-2">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" name="deleteProfileImage" id="deleteProfileImage">
                                            <label class="form-check-label text-white" for="deleteProfileImage">
                                                Remove current photo
                                            </label>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-6"><label class="labels">Name</label><input type="text" class="form-control" name="firstName" placeholder="First Name" value="<%= currentUser.firstName %>"></div>
                            <div class="col-md-6"><label class="labels">Surname</label><input type="text" class="form-control" name="surname" value="" placeholder="Surname"></div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12"><label class="labels">Mobile Number</label><input type="text" class="form-control" name="mobile" placeholder="Enter phone number" value=""></div>
                            <div class="col-md-12">
                                <label class="labels">About</label>
                                <input type="text" 
                                    name="description" 
                                    class="form-control" 
                                    placeholder="Leave something about you.." 
                                    value="<% if (currentUser.description) { %><%=currentUser.description %><% } %>"
                                >
                            </div>
                            <div class="col-md-12">
                                <label class="labels">Email ID</label>
                                <input type="text" class="form-control" name="email" placeholder="enter email id" value="<%= locals.currentUser.email %>">
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6"><label class="labels">Country</label><input type="text" name="country" class="form-control" placeholder="country" value="<%=currentUser.country%>"></div>
                            <div class="col-md-6"><label class="labels">State/Region</label><input type="text" name="state" class="form-control" value="<%=currentUser.state %>" placeholder="state"></div>
                        </div>
                        <div class="mt-4 text-center"><button class="btn btn-primary profile-button" type="submit">Save Profile</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>
    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
</body>
</html>