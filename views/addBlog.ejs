<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blogger</title>
    <style>
      .btn-light-moon {
          background: #FFEFBA;
          background: -webkit-linear-gradient(to right, #FFFFFF, #FFEFBA); 
          background: linear-gradient(to right, #FFFFFF, #FFEFBA); 
          color: #000;
          border: 3px solid #eee;
      }
    </style>
</head> 
<body data-bs-theme="dark">
    <%- include('./partials/nav') %>
    <div class="container mt-3" style="min-height: 80vh;">
        <form action="/blog/" method="post" id="blogForm" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control" placeholder="Enter post title" name="title" id="title">
              </div>
              <div class="mb-3">
                <label for="preview" class="form-label">Preview</label>
                <textarea type="text" class="form-control" placeholder="Enter preview text" rows="2" name="preview" id="preview"></textarea>
              </div>
              <div class="mb-3">
                <label for="body" class="form-label">Body</label>
                <div id="body" contenteditable="true" class="form-control" style="min-height:200px;" id="body"></div>
                <input type="hidden" name="body" id="bodyInput">
                <div class="mt-2 mb-3">
                    <button type="button" id="generateAI" class="col btn btn-light-moon btn-rounded">Generate with AI</button>
                    <button type="button" id="enhanceAI" class="col btn btn-light-moon btn-rounded">Enhance with AI</button>
                </div>
              </div>
              <div class="mb-3">
                <label for="coverImage" class="form-label">Cover-Image</label>
                <input class="form-control" type="file" name="coverImage" id="coverImage">
              </div>
            <div class="mb-3">
                <button class="btn btn-primary" type="submit">Submit</button>
            </div>
        </form>
    </div>
    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
    <%- include('./partials/aiGenerateScript') %>
</body>
</html>
