<!DOCTYPE html>
<html lang="en">
<head>
    <title>Blogger</title>
    <%- include('./partials/head') %>
    <link href='https://fonts.googleapis.com/css?family=Lato:400,300' rel='stylesheet' type='text/css'>
    <!-- Include Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/profile.css">

</head>
<body data-bs-theme="dark">
    <%- include('./partials/nav') %>
    <div class="settings">
        <% if (locals.user && locals.currentUser && locals.user._id.toString()===locals.currentUser._id.toString()) { %>
            <a href="/user/settings">Edit profile</a>
        <% } %>
    </div>
    <div class="box" style="min-height: 80vh;">
        <div id="overlay" class="p-4 text-center">
            <!-- Profile Image -->
            <div class="mb-3">
                <img src="<%= user.profileImage %>" 
                    alt="Profile picture"
                    class="rounded-circle shadow"
                    style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #0d6efd;"
                >
            </div>

            <!-- Name -->
            <h3 class="fw-bold mb-2"><%= user.firstName %> <%= user.lastName || '' %></h3>
            <!-- ABOUT section -->
            <p class="text-muted mb-2">
                <% if (user.description) { %>
                    <%= user.description %>
                <% } %>
            </p>
            <!-- DETAILS section -->
            <div class="text-muted mb-2">
                <% if (user.state || user.country) { %>
                    <p class="mb-2">
                        📍 
                        <% if (user.state) { %>
                            <%= user.state %>,
                        <% } %>
                        <% if (user.country) { %>
                            <%= user.country %>
                        <% } %>
                    </p>
                <% } %>
            </div>

            <div class="d-flex justify-content-center gap-4">
                <div>
                    <h6 class="mb-0"><%= user.followers ? user.followers.length : 0 %></h6>
                    <small class="text-muted">Followers</small>
                </div>
                <div>
                    <h6 class="mb-0"><%= user.following ? user.following.length : 0 %></h6>
                    <small class="text-muted">Following</small>
                </div>
            </div>
            <!-- Follow / Unfollow Button -->
            <% if (user._id.toString() !== currentUser._id.toString()) { %>
            <form action="/user/<%= user.followers.includes(currentUser._id) ? 'unfollow' : 'follow' %>/<%= user.username %>" 
                    class="d-inline-block mt-4 mb-3" method="POST">
                <button type="submit" class="btn <%= user.followers.includes(currentUser._id) ? 'btn-outline-danger' : 'btn-primary' %> px-4">
                    <%= user.followers.includes(currentUser._id) ? 'Unfollow' : 'Follow' %>
                </button>
            </form>
            <% } %>



            <!-- BLOGS in accordion -->
            <div class="d-flex justify-content-center mt-2">
                <div class="accordion shadow-sm w-100" id="accordionExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed fw-semibold" 
                                type="button" 
                                data-bs-toggle="collapse" data-bs-target="#collapseTwo" 
                                aria-expanded="false" aria-controls="collapseTwo"
                            >
                                Blogs
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <% if (locals.allBlogs.length > 0) { %>
                                    <ul class="list-group list-group-flush">
                                    <% locals.allBlogs.forEach(blog => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <a href="/blog/<%= blog._id %>" class="text-decoration-none fw-medium"><%= blog.title %></a>
                                        
                                        <% if (locals.user && locals.currentUser && locals.user._id.toString() === locals.currentUser._id.toString()) { %>
                                            <form action="/blog/delete/<%= blog._id %>" method="POST" 
                                                onsubmit="return confirm('Are you sure you want to delete this blog?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        <% } %>
                                        </li>
                                    <% }) %>
                                    </ul>
                                <% } else { %>
                                    <p class="text-muted">No blogs yet.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
     <%- include('./partials/footer') %>
    <!-- Include Bootstrap 5 JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
